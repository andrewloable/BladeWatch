/.gradle
/.idea
/.kotlin
/local.properties
/build
/.gstack
/node_modules
/app/build
/app/.cxx
/app/src/main/cpp/opencv
/app/src/main/cpp/openh264

# Dolt database files (added by bd init)
.dolt/
*.db
recovered
*.apk
# Ad-hoc debug captures under screenshots/ stay ignored, but the Flutter-vs-
# native parity baseline (BladeWatch-imh6.1/.2 gate deletion of the native UI
# on it) must be versioned so a fresh clone has it.
screenshots/*
!screenshots/native/
!screenshots/flutter/

# Beads / Dolt files (added by bd init)
.beads-credential-key
# Dolt backup chunks — binary, large, regenerable; must never be committed to source
.beads/backup/*.darc
.beads/backup/oldgen/

# Angular / Vite web UI
web/node_modules/
web/dist/
# Angular build output copied into app assets — generated by buildAngularWebUI Gradle task
app/src/main/assets/web/angular/
.gstack/

# Flutter in-car UI (flutter_ui/)
flutter_ui/build/
flutter_ui/.dart_tool/
flutter_ui/android/.gradle/
flutter_ui/android/.kotlin/
flutter_ui/.flutter-plugins*

# Non-Android Flutter platform scaffolding. This project is Android-only (see
# the validateFlutterAndroidOnly Gradle task in app/build.gradle.kts, which
# FAILS the build if any of these exist). These are listed here as well so a
# tree regenerated by `flutter create` cannot be swept into a commit.
# NOTE: this is flutter_ui/web, NOT the repo-root web/ -- that one is the
# Angular SPA and is tracked.
flutter_ui/ios/
flutter_ui/macos/
flutter_ui/windows/
flutter_ui/linux/
flutter_ui/web/
flutter_ui/coverage/
flutter_ui/lcov.info

# Playwright run output — not source
test-results/

# Python bytecode cache — tools/i18n/*.py
__pycache__/
