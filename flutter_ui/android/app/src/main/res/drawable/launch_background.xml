<?xml version="1.0" encoding="utf-8"?>
<!--
  BladeWatch-sjz4: the window background shown from the first frame, before the
  Flutter engine has drawn anything. Plain BLACK in both light and dark mode (the
  owner's decision of 2026-11-19), with ONLY the app icon in the centre.

  The icon sits exactly where, and at the size where, the animated intro
  (BladeIntro in packages/bladewatch_theme) starts: 48 dp, centred. That is what
  makes the handoff from this static frame to the animation invisible. The intro
  then grows the icon and reveals the BladeWatch wordmark, so the wordmark is no
  longer drawn here.

  NOTE: the icon is ic_launcher_FOREGROUND, not ic_launcher. On API 26+ the latter
  resolves to the adaptive-icon XML, which a bitmap element cannot wrap.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
