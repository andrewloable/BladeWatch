<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Adaptive-icon background, copied from the native app's
      app/src/main/res/values/colors.xml so the two packages present an
      IDENTICAL launcher icon while both are installed.

      It is redeclared here rather than referenced across packages on purpose:
      net.bladewatch.app and net.bladewatch.flutter have separate resource
      tables. A shared UID does not give one access to the other's resources.
    -->
    <color name="ic_launcher_background">#0B0F14</color>
</resources>
