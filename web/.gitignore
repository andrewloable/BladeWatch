# Node
node_modules/

# Playwright e2e
e2e/.env
e2e/.auth/
test-results/
playwright-report/
playwright/.cache/

# Test artifacts (vitest JSON reports, Playwright traces/screenshots)
.vitest/

# TypeScript emit directory (tsconfig.app.json sets outDir: ./out-tsc/app).
#
# Pure build output — regenerated by any tsc/ngc run, and stale the moment a source file
# changes. It escaped into a commit once because a typecheck run that did not pass --noEmit
# wrote 42 .js files here and they were picked up by a later `git add`.
#
# The wired gates cannot recreate that: `npm run typecheck` passes --noEmit and
# tsconfig.templates.json sets "noEmit": true. This rule is the backstop for an ad-hoc run.
out-tsc/
